  file = {PDF:/home/hnorg/snap/zotero-snap/common/Zotero/storage/CZZHF7NA/Saraiva et al. - AN ECONOMIC ENERGY APPROACH FOR QUERIES ON DATA CENTERS.pdf:application/pdf},
}

