@inproceedings{maroulisexpress2017,
  address = {Columbus, OH, USA},
  title = {{ExpREsS}: {EneRgy} {Efficient} {Scheduling} of {Mixed} {Stream} and {Batch} {Processing} {Workloads}},
  isbn = {978-1-5386-1762-5},
  shorttitle = {{ExpREsS}},
  url = {http://ieeexplore.ieee.org/document/8005324/},
  doi = {10.1109/ICAC.2017.43},
  abstract = {Nowadays we see the wide adoption of novel distributed processing frameworks such as Apache Spark for handling batch and stream processing big data applications. An important aspect that has not been examined in these systems is their energy consumption during the application execution. Reducing the power consumption of modern datacenters is a necessity as datacenters contribute over 2\% of the total US electric usage. One way of addressing this energy issue is by scheduling the applications in an energy-efﬁcient way. However, efﬁciently scheduling applications can be challenging as we need to consider the trade-off between the datacenter’s energy usage and per application performance requirements. In this work we propose, ExpREsS, a scheduler for orchestrating the execution of Spark applications so that it both minimizes the energy consumption and satisﬁes the applications’ performance requirements. Our approach exploits time-series prediction models for capturing the applications’ energy usage and execution times, and then applies a novel DVFS technique to minimize the energy consumption. Our detailed experimental evaluation using realistic workloads on our local cluster illustrates the working and beneﬁts of our approach.},
  urldate = {2025-09-27},
  booktitle = {2017 {IEEE} {International} {Conference} on {Autonomic} {Computing} ({ICAC})},
  publisher = {IEEE},
  author = {Maroulis, Stathis and Zacheilas, Nikos and Kalogeraki, Vana},
  month = jul,
  year = {2017},
  pages = {27--32},
  file = {PDF:/home/hnorg/snap/zotero-snap/common/Zotero/storage/CAUZP3EJ/Maroulis et al. - 2017 - ExpREsS EneRgy Efficient Scheduling of Mixed Stream and Batch Processing Workloads.pdf:application/pdf},
}

